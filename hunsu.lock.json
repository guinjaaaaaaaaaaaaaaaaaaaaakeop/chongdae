  "resolutions": {
    "building a slice": {
      "order": [
        "chongdae:run",
        "hacheong:hire",
        "mangsang:operate"
      ],
      "accept": "chongdae assigns tasks by lock roles; the session does a member's work only via a recorded `take --why`/`--role session --why`; mangsang writes in a scoped task",
      "note": "judge's use/order proposals merged by the chongdae setup session under delegated setup; no person read it",
      "reviewed": false
    },
    "reviewing, disputing or trying a change": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "accept": "jokbo's hooks are silent under AGENT_WORKER=1, set by hacheong's subprocess workers; a review record made by hand is committed in a chongdae run task",
      "note": "setup session's choice instead of the judge's `deny plugin:jokbo`; native subagents not covered; no person read it",
      "reviewed": false
    },
    "a decision waiting on the person": {
      "order": [
        "chongdae:run",
        "dwitbuk:review",
        "mangsang:operate"
      ],
      "accept": "`--delegated` only on what the person handed off (a chongdae delegation or their recorded words), else ask; dispositions go in a run task scoped to reviews/",
      "note": "judge's two accepts narrowed to one choice by the chongdae setup session under delegated setup; no person read it",
      "reviewed": false
    },
    "asking what happened or what is open": {
      "order": [
        "jokbo:read",
        "dwitbuk:review"
      ],
      "note": "judge's proposal, applied by the chongdae setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    },
    "before a merge": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "note": "judge's proposal, applied by the chongdae setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    }
