{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "chongdae — is a run in progress?"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_write.py\"",
            "timeout": 10,
            "statusMessage": "chongdae — writes happen inside a run"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
