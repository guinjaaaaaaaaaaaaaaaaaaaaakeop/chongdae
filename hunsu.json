{
  "engines": {
    "python": ">=3.11",
    "claude-code": ">=2.1"
  },
  "plugins": {
    "hunsu": {
      "version": "1.15.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hunsu",
      "marketplace": "hunsu"
    },
    "chongdae": {
      "version": "1.24.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/chongdae",
      "marketplace": "chongdae"
    },
    "mangsang": {
      "version": "1.19.3",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/mangsang",
      "marketplace": "mangsang"
    },
    "jokbo": {
      "version": "1.8.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/jokbo",
      "marketplace": "jokbo"
    },
    "hacheong": {
      "version": "1.12.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hacheong",
      "marketplace": "hacheong"
    },
    "dwitbuk": {
      "version": "1.16.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/dwitbuk",
      "marketplace": "dwitbuk"
    }
  },
  "roles": {
    "planner": "session",
    "implementer": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "dakdol",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex"
    ],
    "nitpick": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "teujip",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "quibble": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "sibi",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "newbie": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "chojja",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex"
    ],
    "verifier": [
      "python3",
      "{plugin:dwitbuk}/eyes_worker.py",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "reviewer": [
      "python3",
      "{plugin:dwitbuk}/dwitbuk.py",
      "review",
      "--target",
      "."
    ],
    "coherence": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--target",
      "."
    ]
  },
  "reporters": {
    "hunsu": [
      "python3",
      "{plugin:hunsu}/hunsu.py",
      "check",
      "--findings",
      "--target",
      "."
    ],
    "chongdae": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "report",
      "--since",
      "{since}",
      "--target",
      "."
    ],
    "mangsang": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--findings",
      "--target",
      "."
    ]
  },
  "resolutions": {
    "building a slice": {
      "order": [
        "chongdae:run",
        "hacheong:hire",
        "mangsang:operate"
      ],
      "accept": "chongdae assigns tasks by lock roles; the session does a member's work only via a recorded `take --why`/`--role session --why`; mangsang writes in a scoped task",
      "note": "judge's use/order proposals merged by the chongdae setup session under delegated setup; no person read it",
      "reviewed": false
    },
    "reviewing, disputing or trying a change": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "accept": "jokbo's hooks are silent under AGENT_WORKER=1, set by hacheong's subprocess workers; a review record made by hand is committed in a chongdae run task",
      "note": "setup session's choice instead of the judge's `deny plugin:jokbo`; native subagents not covered; no person read it",
      "reviewed": false
    },
    "a decision waiting on the person": {
      "order": [
        "chongdae:run",
        "dwitbuk:review",
        "mangsang:operate"
      ],
      "accept": "`--delegated` only on what the person handed off (a chongdae delegation or their recorded words), else ask; dispositions go in a run task scoped to reviews/",
      "note": "judge's two accepts narrowed to one choice by the chongdae setup session under delegated setup; no person read it",
      "reviewed": false
    },
    "asking what happened or what is open": {
      "order": [
        "jokbo:read",
        "dwitbuk:review"
      ],
      "note": "judge's proposal, applied by the chongdae setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    },
    "before a merge": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "note": "judge's proposal, applied by the chongdae setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    }
  },
  "local-hooks-ok": [],
  "capabilities": {
    "loopback": "session",
    "network": "session"
  }
}
