{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chongdae",
  "version": "1.18.0",
  "engines": {
    "python": ">=3.9"
  },
  "records": [
    ".chongdae/"
  ],
  "description": "The orchestrator for an era where development is split into parts done by agents.",
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/codex.json"
    }
  },
  "reads": {
    "file": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--path",
      "{path}",
      "--target",
      "{target}"
    ],
    "since": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--since",
      "{since}",
      "--target",
      "{target}"
    ],
    "note": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--path",
      "{path}",
      "--brief",
      "--target",
      "{target}"
    ],
    "map": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--brief",
      "--target",
      "{target}"
    ]
  }
}
