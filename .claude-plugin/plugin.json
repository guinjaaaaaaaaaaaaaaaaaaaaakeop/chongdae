{
  "name": "chongdae",
  "version": "1.17.0",
  "engines": {
    "python": ">=3.9"
  },
  "records": [
    ".chongdae/"
  ],
  "description": "The orchestrator for an era where development is split into parts done by agents. Runs a plan — a DAG of roles with checks in code and human gates in between — and records the run apart from commit history: what was decided, by whom, and what was not verified.",
  "reads": {
    "file": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--path",
      "{path}",
      "--target",
      "{target}"
    ],
    "since": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--since",
      "{since}",
      "--target",
      "{target}"
    ],
    "note": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--path",
      "{path}",
      "--brief",
      "--target",
      "{target}"
    ],
    "map": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "show",
      "--brief",
      "--target",
      "{target}"
    ]
  }
}
